# Order Flow Engine V2.5 - Environment Configurations

# AI Interpretation Settings
AI_ENABLED=false
AI_PROVIDER=openai
AI_INTERVAL_SECONDS=120
AI_TIMEOUT_SECONDS=20
AI_MAX_SYMBOLS=20
AI_CACHE_TTL_SECONDS=60
AI_LOG_PROMPTS=false
AI_SSL_VERIFY=true

# OpenAI Settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Google Gemini Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash

# Anthropic Claude Settings
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# DeepSeek Settings
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
